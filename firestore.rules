rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email == 'syntrex@gmail.com' ||
        request.auth.token.email == 'digitalplaygrid@gmail.com' ||
        request.auth.token.email == 'digitalsyntrex@gmail.com'
      );
    }

    // Test connection check
    match /test/{testId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public Subscription Plans (Read-only catalog for users and visitors)
    match /subscription_plans/{planId} {
      allow read: if true;
      allow write: if isSignedIn() && (
        request.auth.token.email in ['syntrex@gmail.com', 'digitalplaygrid@gmail.com', 'digitalsyntrex@gmail.com']
      );
    }

    // Public / Shared Demo Series (Read-only for all visitors & demo explore)
    match /demoSeries/{seriesId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // User Profile Documents - allows user to read and update their profile document
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (
        request.auth.uid == userId ||
        request.auth.token.email in ['syntrex@gmail.com', 'digitalplaygrid@gmail.com', 'digitalsyntrex@gmail.com']
      );
    }

    // User Subscriptions (Subscriber and admin records)
    match /subscriptions/{subId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // User Entitlements (Subscriber and admin permissions)
    match /entitlements/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Trial Usage Records (Anti-abuse tracking)
    match /trial_usage/{trialId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Payment Receipts & Transaction Log
    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    // Playthrough Series (Subscriber-owned content)
    match /userSeries/{seriesId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // In-App Contact & Feedback Messages
    match /contact_messages/{messageId} {
      // Any visitor or user can submit a message
      allow create: if true;
      // Admins can read, update status/notes, or delete; users can read their own messages
      allow read: if isSignedIn() && (
        request.auth.token.email in ['syntrex@gmail.com', 'digitalplaygrid@gmail.com', 'digitalsyntrex@gmail.com'] ||
        (resource.data.userId != null && request.auth.uid == resource.data.userId)
      );
      allow update, delete: if isSignedIn() && (
        request.auth.token.email in ['syntrex@gmail.com', 'digitalplaygrid@gmail.com', 'digitalsyntrex@gmail.com']
      );
    }

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

